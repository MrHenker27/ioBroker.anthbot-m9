{
  "type": "panel",
  "i18n": true,
  "items": {
    "username": {
      "type": "text",
      "label": "Anthbot account username",
      "help": "The email address associated with your Anthbot account",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "password": {
      "type": "password",
      "label": "Anthbot account password",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "areaCode": {
      "type": "text",
      "label": "Area code",
      "newLine": true,
      "help": "Examples: 49 for Germany, 32 for Belgium, 1 for US/Canada",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "errorDescriptionLanguage": {
      "type": "select",
      "label": "Error description language",
      "help": "Language used for Anthbot cloud error descriptions",
      "options": [
        {
          "label": "English",
          "value": "English"
        },
        {
          "label": "German",
          "value": "German"
        },
        {
          "label": "French",
          "value": "French"
        },
        {
          "label": "Spanish",
          "value": "Spain"
        },
        {
          "label": "Italian",
          "value": "Italy"
        },
        {
          "label": "Polish",
          "value": "Polish"
        },
        {
          "label": "Russian",
          "value": "Russian"
        },
        {
          "label": "Czech",
          "value": "Czech"
        },
        {
          "label": "Estonian",
          "value": "Estonian"
        },
        {
          "label": "Latvian",
          "value": "Latvian"
        },
        {
          "label": "Lithuanian",
          "value": "Lithuanian"
        },
        {
          "label": "Romanian",
          "value": "Romanian"
        },
        {
          "label": "Slovak",
          "value": "Slovakia"
        }
      ],
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "apiHost": {
      "type": "text",
      "label": "API host",
      "hidden": "true",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "mqttEnabled": {
      "type": "checkbox",
      "label": "Enable MQTT live updates",
      "help": "Receive device shadow changes immediately through AWS IoT MQTT",
      "default": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "newLine": true
    },
    "pollIntervalActive": {
      "type": "number",
      "label": "Poll interval while active (seconds)",
      "help": "Refresh interval while mowing, mapping, returning or remote controlling",
      "min": 15,
      "max": 3600,
      "step": 1,
      "default": 30,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "newLine": true
    },
    "pollIntervalCharging": {
      "type": "number",
      "label": "Poll interval while charging (seconds)",
      "help": "Refresh interval while the mower is charging",
      "min": 15,
      "max": 3600,
      "step": 1,
      "default": 60,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "pollIntervalIdle": {
      "type": "number",
      "label": "Poll interval during recent idle (seconds)",
      "help": "Refresh interval during the first minutes in standby or pause",
      "min": 15,
      "max": 3600,
      "step": 1,
      "default": 60,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "pollIntervalIdleLong": {
      "type": "number",
      "label": "Poll interval during long idle (seconds)",
      "help": "Reduced refresh interval after the mower has remained idle for longer",
      "min": 15,
      "max": 3600,
      "step": 1,
      "default": 180,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "newLine": true
    },
    "idleLongAfterMinutes": {
      "type": "number",
      "label": "Long idle starts after (minutes)",
      "help": "After this time in standby or pause, the long-idle interval is used",
      "min": 1,
      "max": 1440,
      "step": 1,
      "default": 10,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "nightPollingEnabled": {
      "type": "checkbox",
      "label": "Enable reduced polling at night",
      "help": "Use a separate interval during the configured night window while Kevin is not active",
      "default": false,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "pollIntervalNight": {
      "type": "number",
      "label": "Poll interval at night (seconds)",
      "help": "Refresh interval in the optional night window",
      "min": 15,
      "max": 3600,
      "step": 1,
      "default": 300,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "newLine": true,
      "hidden": "data.nightPollingEnabled !== true"
    },
    "nightStartHour": {
      "type": "number",
      "label": "Night starts at (hour)",
      "help": "Local server hour from which night polling is used",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 22,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.nightPollingEnabled !== true"
    },
    "nightEndHour": {
      "type": "number",
      "label": "Night ends at (hour)",
      "help": "Local server hour at which normal polling resumes",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 6,
      "xs": 12,
      "sm": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "hidden": "data.nightPollingEnabled !== true"
    },
    "diagHeader": {
      "type": "header",
      "text": "GNSS and RTK diagnostics",
      "size": 2,
      "newLine": true
    },
    "diagInfo": {
      "type": "staticText",
      "text": "Live values received from Kevin and the RTK base. Missing values are shown as not transmitted; numeric RTK codes are not guessed.",
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "diagValues": {
      "type": "panel",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "newLine": true,
      "items": {
        "diagDevice": {
          "type": "state",
          "label": "Device",
          "oid": "diagnostics.admin.device",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "diagRobotFix": {
          "type": "state",
          "label": "Kevin GNSS fix",
          "oid": "diagnostics.admin.robotFix",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagRobotSat": {
          "type": "state",
          "label": "Kevin satellites",
          "oid": "diagnostics.admin.robotSatellites",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagBaseSat": {
          "type": "state",
          "label": "RTK base satellites",
          "oid": "diagnostics.admin.baseSatellites",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagAssessment": {
          "type": "state",
          "label": "Assessment",
          "oid": "diagnostics.admin.assessment",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagMqtt": {
          "type": "state",
          "label": "MQTT",
          "oid": "diagnostics.admin.mqtt",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagBaseState": {
          "type": "state",
          "label": "RTK base status",
          "oid": "diagnostics.admin.baseState",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagMoved": {
          "type": "state",
          "label": "RTK antenna moved",
          "oid": "diagnostics.admin.antennaMoved",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true,
          "trueText": "Ja",
          "falseText": "Nein"
        },
        "diagRobotRaw": {
          "type": "state",
          "label": "Kevin raw status",
          "oid": "diagnostics.admin.robotRawStatus",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagUpdate": {
          "type": "state",
          "label": "Last update",
          "oid": "diagnostics.admin.lastUpdate",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagHttp": {
          "type": "state",
          "label": "HTTP polling",
          "oid": "diagnostics.admin.httpPolling",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        },
        "diagBackoff": {
          "type": "state",
          "label": "HTTP backoff until",
          "oid": "diagnostics.admin.httpBackoffUntil",
          "control": "text",
          "readOnly": true,
          "narrow": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "newLine": true
        }
      }
    },
    "diagSkyplot": {
      "type": "state",
      "label": "RTK satellite map",
      "oid": "diagnostics.admin.skyplotHtml",
      "control": "html",
      "readOnly": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    }
  }
}
